{
  "name": "angelo-tutoring",
  "version": "1.0.0",
  "description": "Angelo Tutoring - Grade 10-12 Maths & Science Tutoring Platform for South African Students",
  "private": true,
  "dependencies": {
    "@capacitor/app": "^5.0.7",
    "@capacitor/camera": "^5.0.7",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/device": "^5.0.7",
    "@capacitor/filesystem": "^5.2.0",
    "@capacitor/haptics": "^5.0.7",
    "@capacitor/network": "^5.0.7",
    "@capacitor/push-notifications": "^5.1.0",
    "@common/global-config": "file:./common",
    "@material-ui/core": "~4.12.3",
    "@material-ui/icons": "~4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@supabase/supabase-js": "^2.97.0",
    "algebrite": "~1.4.0",
    "await-to-js": "~3.0.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.4.0",
    "clsx": "~1.1.1",
    "crypto-js": "^4.2.0",
    "equation-editor-react": "https://github.com/CAHLR/equation-editor-react-forked/releases/download/v0.0.10/equation-editor-react-0.0.10.tgz",
    "expr-eval": "~2.0.2",
    "firebase": "~9.9.1",
    "http2": "~3.3.7",
    "jspdf": "^2.5.1",
    "list-react-files": "~0.2.0",
    "localforage": "~1.10.0",
    "mathlive": "^0.98.3",
    "random-seed": "~0.3.0",
    "react": "~16.14.0",
    "react-cursor-position": "~3.0.3",
    "react-dom": "~16.14.0",
    "react-katex": "~2.0.2",
    "react-medium-image-zoom": "^4.3.5",
    "react-router-dom": "~5.3.0",
    "react-scripts": "~5.0.1",
    "react-scroll": "~1.8.4",
    "react-toastify": "~8.0.2",
    "sql.js": "^1.14.1",
    "typeface-roboto": "~0.0.75",
    "underscore": "~1.13.1",
    "universal-cookie": "~4.0.4",
    "use-window-focus": "^1.4.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "cross-env PORT=3001 react-app-rewired start",
    "prestart": "node src/tools/preprocessProblemPool.js",
    "build": "react-app-rewired build",
    "build-localhost": "cross-env PUBLIC_URL=/ react-app-rewired build",
    "build:cloudflare": "cross-env PUBLIC_URL=/ CI=false GENERATE_SOURCEMAP=false react-app-rewired build",
    "prebuild": "node src/tools/preprocessProblemPool.js",
    "prebuild-localhost": "node src/tools/preprocessProblemPool.js",
    "prebuild:cloudflare": "node src/tools/preprocessProblemPool.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler pages deploy build --project-name=angelo-tutoring",
    "build:prod": "cross-env PUBLIC_URL=/ GENERATE_SOURCEMAP=false CI=false react-app-rewired build",
    "build:analyze": "cross-env PUBLIC_URL=/ CI=false GENERATE_SOURCEMAP=true react-app-rewired build && npx source-map-explorer 'build/static/js/*.js'",
    "lint": "eslint src/ --ext .js,.jsx --max-warnings 50",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "test": "react-app-rewired test",
    "pretest": "node src/tools/preprocessProblemPool.js",
    "eject": "react-scripts eject",
    "fix-lockfile": "npm install --package-lock-only",
    "serve": "npx serve -s build -l 3000",
    "clean": "rm -rf build node_modules/.cache"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-resizable": "~1.7.4",
    "cross-env": "^7.0.3",
    "gh-pages": "~2.2.0",
    "mathlive": "^0.98.3",
    "react-app-rewire-alias": "~1.1.7",
    "react-app-rewired": "~2.2.1",
    "react-window": "^1.8.11"
  },
  "homepage": "/",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
