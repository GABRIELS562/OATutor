        "dependencies": ["alg-exponent-001a-h1"],
        "title": "Apply Power of a Power Rule",
        "text": "$(a^m)^n = a^{mn}$\\n\\n$9^x = (3^2)^x = 3^{2x}$\\n$27^{x-1} = (3^3)^{x-1} = 3^{3(x-1)} = 3^{3x-3}$",
        "variabilization": {},
