        "dependencies": ["trig-comp-001b-h2"],
        "title": "Calculate First Term",
        "text": "Calculate $$\\sin 45° \\cdot \\cos 30°$$:\n$$= \\frac{\\sqrt{2}}{2} \\cdot \\frac{\\sqrt{3}}{2} = \\frac{\\sqrt{6}}{4}$$\n\nEnter as: sqrt(6)/4",
        "variabilization": {},
        "oer": "DBE NSC Paper 2",
        "license": "Public Domain"
    },
