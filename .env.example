# SA CAPS Tutor Environment Configuration
# Copy this file to .env and fill in your values

# =============================================
# SUPABASE (FREE TIER)
# Get credentials from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# =============================================
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =============================================
# GROQ AI (FREE TIER - 500K tokens/day)
# Get API key from: https://console.groq.com/keys
# =============================================
REACT_APP_GROQ_API_KEY=your_groq_api_key_here

# =============================================
# GOOGLE GEMINI (FREE TIER BACKUP - 1000 req/day)
# Get API key from: https://makersuite.google.com/app/apikey
# =============================================
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# =============================================
# OPTIONAL CONFIGURATION
# =============================================

# Study identifier for A/B testing
# REACT_APP_STUDY_ID=sa-caps-2024

# Build info (auto-set by CI/CD)
# REACT_APP_COMMIT_HASH=abc123
# REACT_APP_BUILD_TIMESTAMP=2024-01-01T00:00:00Z

# Enable specific features
# REACT_APP_ENABLE_AI_HINTS=true
# REACT_APP_ENABLE_OFFLINE_MODE=true
