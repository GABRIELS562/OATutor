# =============================================
# Angelo Tutoring Production Environment
# For deployment to jagdevops.com
# =============================================

# Build Configuration
REACT_APP_BUILD_TYPE=production
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# Performance optimization
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true

# Version info (auto-set by CI/CD if available)
# REACT_APP_VERSION=1.0.0
# REACT_APP_COMMIT_HASH=abc123
# REACT_APP_BUILD_TIMESTAMP=2026-02-25T00:00:00Z

# =============================================
# REQUIRED: Set these in your hosting platform
# (Cloudflare Pages, Vercel, or Netlify)
# =============================================

# Supabase - FREE tier (500MB database, unlimited API)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=your_anon_key

# Groq AI - FREE tier (500K tokens/day)
# Get from: https://console.groq.com/keys
# REACT_APP_GROQ_API_KEY=your_groq_key

# Google Gemini - FREE tier backup (1000 req/day)
# Get from: https://makersuite.google.com/app/apikey
# REACT_APP_GEMINI_API_KEY=your_gemini_key

# =============================================
# Site Info
# =============================================
REACT_APP_SITE_URL=https://jagdevops.com
REACT_APP_SITE_NAME=Angelo Tutoring

# =============================================
# Feature Flags
# =============================================
REACT_APP_ENABLE_AI_HINTS=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_GAMIFICATION=true

# =============================================
# Admin Portal Demo Mode
# Set these to enable demo login for teachers
# =============================================
REACT_APP_DEMO_MODE=true
# REACT_APP_DEMO_TEACHER_EMAIL=teacher@yourschool.co.za
# REACT_APP_DEMO_TEACHER_PASS=change_this_password
# REACT_APP_DEMO_TEACHER_NAME=Demo Teacher
# REACT_APP_DEMO_ADMIN_EMAIL=admin@yourschool.co.za
# REACT_APP_DEMO_ADMIN_PASS=change_this_password
# REACT_APP_DEMO_ADMIN_NAME=Demo Admin

# =============================================
# Analytics (Optional)
# =============================================
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXX-X
# REACT_APP_SENTRY_DSN=https://xxx@sentry.io/xxx
